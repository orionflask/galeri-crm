# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string
# - Local without Docker: run `pnpm db:dev`, then use the "TCP" URL it prints, e.g.
#   postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
# - Local PostgreSQL: postgresql://postgres:postgres@localhost:5432/galeri_crm
# - Neon / Supabase: use the connection string from the provider dashboard
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/galeri_crm"
